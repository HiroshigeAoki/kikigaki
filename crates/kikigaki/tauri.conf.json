{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kikigaki",
  "version": "0.1.1",
  "identifier": "dev.aoki.kikigaki",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "settings",
        "title": "kikigaki",
        "url": "settings.html",
        "width": 480,
        "height": 640,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../NOTICE": "NOTICE",
      "../../licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "frameworks": ["vendor/onnxruntime/libonnxruntime.dylib"]
    }
  }
}
